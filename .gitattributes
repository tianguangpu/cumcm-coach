# 统一换行符为 LF，避免 Windows/macOS/Linux 协作时产生整文件 diff
* text=auto eol=lf

# 明确声明为文本的文件类型
*.py    text diff=python
*.md    text
*.txt   text
*.toml  text
*.yaml  text
*.yml   text
*.json  text
*.tex   text
*.typ   text
*.bib   text
Makefile text

# 二进制文件（不做换行符转换，不做文本 diff）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.docx  binary
*.zip   binary

# 编译产物不参与统计
*.pdf   -diff
*.png   -diff

# 修正 GitHub 语言统计：integrations 下 HTML 是第三方 skill 资源，不计入主语言统计
integrations/**/*.html linguist-vendored=true
integrations/diagram-design/** linguist-vendored=true
